// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tcg {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  status      String   @default("ACTIVE") // "ACTIVE", "SUSPENDED", "NOT_PLAYED"
  imageUrl    String?
  color       String?  // accent color for the TCG card
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournaments Tournament[]
  decklists   Decklist[]
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  tag         String   @default("NOTICIAS") // "LEAKS & REVEALS", "BANLIST", "PRODUCTO NUEVO", "RESULTADOS", "DECK PROFILE", "COMUNIDAD", "ANUNCIO"
  tcgSlug     String?  // "yugioh", "one-piece", "digimon", "general"
  sourceUrl   String?  // URL original externa (ej: https://ygorganization.com/...)
  sourceName  String?  // Nombre de la fuente (ej: "YGOrganization", "Digimon Meta")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  location    String?
  prize       String?
  photoUrl    String?  // Foto del torneo / foto del podio / campeón
  bannerUrl   String?  // Imagen banner torneo (fondo de la card del torneo)
  tcgId       String
  tcg         Tcg      @relation(fields: [tcgId], references: [id])
  participantsCount Int @default(0)
  status      String   @default("UPCOMING") // "UPCOMING", "ONGOING", "COMPLETED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decklists   Decklist[]
}

model Player {
  id          String     @id @default(cuid())
  name        String     @unique // Nombre normalizado del jugador
  nickname    String?    // Apodo
  avatarUrl   String?    // Foto / Avatar / Carta insignia
  phone       String?    // WhatsApp / Contacto
  points      Int        @default(0) // Puntos acumulados en el ranking
  decklists   Decklist[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Decklist {
  id            String      @id @default(cuid())
  playerName    String
  playerId      String?
  player        Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)
  placement     Int         @default(0) // 0 for recommended guides, 1,2,3,4,8 for tournament tops
  deckName      String?
  isRecommended Boolean     @default(false)
  tournamentId  String?
  tournament    Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tcgId         String
  tcg           Tcg         @relation(fields: [tcgId], references: [id], onDelete: Cascade)
  deckData      String      // JSON stringified
  adminNotes    String?     // Optional commentary or review by admin
  coverImageUrl String?     // Cover art / featured card / ace monster for thumbnails
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  category    String?  // "SLEEVES", "PLAYMATS", "SINGLES", "ACCESORIOS"
  status      String   @default("AVAILABLE") // "AVAILABLE", "OUT_OF_STOCK", "HIDDEN"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. "instagram_url", "whatsapp_number", "discord_url", "tiktok_url", "youtube_url", "whatsapp_group_url"
  value       String
  updatedAt   DateTime @updatedAt
}

model LocalStore {
  id           String   @id @default(cuid())
  name         String
  description  String?
  logoUrl      String?
  location     String
  mapsUrl      String?  // Link de Google Maps de la tienda
  phone        String?
  instagramUrl String?
  schedule     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CommunityGroup {
  id          String   @id @default(cuid())
  name        String
  tcgName     String   @default("GENERAL") // "Yu-Gi-Oh!", "One Piece", "Digimon", "GENERAL"
  inviteUrl   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
